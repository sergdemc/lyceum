# Приложение читает эти переменные. Секретов здесь нет.
# Значения лежат в .env. Миграцию и push на VPS делаю я сам.

DATABASE_URL=sqlite:///./data/lyceum.db

# Канал, не форум. Бот — админ канала с правом публиковать.
# TELEGRAM_CHAT_ID: @username публичного канала или id вида -100…
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Следующий срез: пакет cursor-sdk, ключ из Cursor Dashboard → API Keys.
# Пока саммари в тестах — заглушка, ключ не нужен.
CURSOR_API_KEY=
SUMMARIZER=fake
